/* ALCANSAR QR CREATOR - Modern Teal Design System */

/* ========== ROOT STYLES ========== */
QMainWindow, QDialog {
    background-color: #0F172A;
    color: #E2E8F0;
}

QWidget {
    background-color: #0F172A;
    color: #E2E8F0;
}

/* ========== INPUT ZONE STYLES ========== */
QLineEdit, QTextEdit, QComboBox {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid rgba(45, 212, 191, 0.4);
    border-radius: 8px;
    padding: 10px;
    font-family: "Courier New", monospace;
    font-size: 13px;
    selection-background-color: #14B8A6;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 2px solid #14B8A6;
    background-color: #1E293B;
    box-shadow: 0 0 20px rgba(20, 184, 166, 0.3);
    outline: none;
}

QLineEdit::placeholder {
    color: #64748B;
}

/* ========== BUTTON STYLES ========== */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #14B8A6, stop:1 #0D9488);
    color: #0F172A;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 600;
    min-height: 40px;
    min-width: 100px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #2DD4BF, stop:1 #14B8A6);
    box-shadow: 0 12px 32px rgba(20, 184, 166, 0.3);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0D9488, stop:1 #0A7368);
}

QPushButton:disabled {
    background-color: #1E293B;
    color: #64748B;
}

/* ========== SECONDARY BUTTONS ========== */
QPushButton#secondaryBtn {
    background-color: #1E293B;
    color: #2DD4BF;
    border: 1px solid #0F766E;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 12px;
}

QPushButton#secondaryBtn:hover {
    background-color: #0F766E;
    border: 1px solid #2DD4BF;
}

/* ========== LABEL STYLES ========== */
QLabel {
    color: #E2E8F0;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel#title {
    color: #E2E8F0;
    font-size: 16px;
    font-weight: 600;
}

QLabel#subtitle {
    color: #94A3B8;
    font-size: 12px;
}

QLabel#statusLabel {
    color: #10B981;
    font-size: 11px;
    font-weight: 500;
}

/* ========== GROUP BOX STYLES ========== */
QGroupBox {
    border: 1px solid rgba(45, 212, 191, 0.2);
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 8px;
    color: #E2E8F0;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}

/* ========== COMBO BOX STYLES ========== */
QComboBox {
    min-height: 32px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    background-color: rgba(45, 212, 191, 0.3);
    border-radius: 4px;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #E2E8F0;
    selection-background-color: #0F766E;
    border: 1px solid #0F766E;
}

/* ========== SCROLL BAR STYLES ========== */
QScrollBar:vertical {
    background-color: #1E293B;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #0F766E;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #14B8A6;
}

/* ========== FRAME & CONTAINER STYLES ========== */
QFrame#previewFrame {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 20px;
}

QFrame#inputFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #1E293B, stop:1 rgba(15, 118, 110, 0.1));
    border-radius: 12px;
    padding: 20px;
}

QFrame#settingsFrame {
    background-color: #1E293B;
    border-top: 1px solid #0F766E;
    padding: 12px 16px;
}

/* ========== SPINNER/SPINBOX STYLES ========== */
QSpinBox, QDoubleSpinBox {
    background-color: #0F172A;
    color: #E2E8F0;
    border: 1px solid rgba(45, 212, 191, 0.4);
    border-radius: 6px;
    padding: 6px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    width: 20px;
    border: none;
    background-color: rgba(20, 184, 166, 0.2);
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #14B8A6;
}

/* ========== CHECKBOX & RADIO STYLES ========== */
QCheckBox, QRadioButton {
    color: #E2E8F0;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    background-color: #0F172A;
    border: 2px solid #0F766E;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #14B8A6;
    border: 2px solid #14B8A6;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 2px solid #2DD4BF;
}

/* ========== SLIDER STYLES ========== */
QSlider::groove:horizontal {
    background-color: #1E293B;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #14B8A6;
    width: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #2DD4BF;
}

/* ========== MESSAGE BOX STYLES ========== */
QMessageBox {
    background-color: #0F172A;
}

QMessageBox QLabel {
    color: #E2E8F0;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ========== TOOLTIP STYLES ========== */
QToolTip {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #0F766E;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ========== STATUS BAR ========== */
QStatusBar {
    background-color: #1E293B;
    color: #94A3B8;
    border-top: 1px solid #0F766E;
}
